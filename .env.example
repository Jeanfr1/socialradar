# BrandPulse environment template. Copy to .env.local (gitignored) and fill in values.
# Never put provider credentials (Buffer API keys) here: add them through Settings → Connections
# or `npm run connections:import`, which encrypts them into the database.

# --- Database (PostgreSQL 15+) ---
# Local development: `npm run db:local` starts an embedded PostgreSQL and prints this URL.
DATABASE_URL=postgres://brandpulse:change-me@127.0.0.1:54329/brandpulse

# --- Credential encryption (key-encryption key, 32 random bytes, base64) ---
# Keep the key OUTSIDE the database and the repository. Prefer a file injected by your secret manager.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BRANDPULSE_KEK_FILE=
# Alternatively (less preferred) provide the key directly:
BRANDPULSE_KEK=
# Increment when rotating the key; keep the previous key available as BRANDPULSE_KEK_PREVIOUS until re-encryption finishes.
BRANDPULSE_KEK_VERSION=1
BRANDPULSE_KEK_PREVIOUS=

# --- Application ---
APP_BASE_URL=http://localhost:3000
# Set to "true" only behind HTTPS (marks session cookies Secure).
SECURE_COOKIES=false

# --- Optional: AI narratives for weekly reports and recommendations ---
# Leave empty to use deterministic narratives only.
ANTHROPIC_API_KEY=
BRANDPULSE_AI_MODEL=claude-opus-5

# --- Buffer quota policy (shared with your existing publishing automations) ---
# BrandPulse stops non-essential sync when remaining quota in a window falls below these reserves.
BUFFER_RESERVE_15MIN=40
BUFFER_RESERVE_DAILY=120
BUFFER_RESERVE_30DAY=1200
# Target polling interval for queue sync (minutes). The worker widens it automatically when quota is tight.
BUFFER_QUEUE_SYNC_MINUTES=120
BUFFER_METRICS_SYNC_HOURS=24

# --- Worker ---
WORKER_POLL_INTERVAL_MS=5000
LOG_LEVEL=info

# --- Serverless deployments (Vercel Cron instead of a long-running worker) ---
# Secret for /api/cron/tick. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Without it the endpoint returns 404 and no scheduled work runs.
CRON_SECRET=
# Time budget per cron invocation (must stay below the function maxDuration).
CRON_BUDGET_MS=45000
# Keep the pool small when using Supabase's session pooler from serverless functions.
DB_POOL_MAX=3
# Connection behaviour (serverless defaults are fine for most deployments).
DB_CONNECT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=10000
